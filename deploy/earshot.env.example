# /etc/earshot.env — out-of-repo Earshot runtime & TURN secrets (chmod 600, root:root)
# Copy to /etc/earshot.env on the VPS (or let deploy/install.sh bootstrap it)
# and generate EARSHOT_TURN_SECRET with: openssl rand -hex 32

EARSHOT_DOMAIN=earshot.example.com
EARSHOT_TURN_HOST=turn:earshot.example.com:3478
EARSHOT_TURN_SECRET=__GENERATE_WITH_OPENSSL_RAND_HEX_32__
