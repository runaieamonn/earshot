[Unit]
Description=Earshot coordinator (control plane, RAM-only)
After=network.target

[Service]
User=earshot
WorkingDirectory=/opt/earshot
ExecStart=/opt/earshot/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8700
Restart=always
RestartSec=3
# privacy: no coordinates in logs; uvicorn access log off
Environment=UVICORN_ACCESS_LOG=0
# TURN credential minting for /ice — loaded from /etc/earshot.env (chmod 600, outside git):
#   EARSHOT_TURN_HOST=turn:<domain>:3478
#   EARSHOT_TURN_SECRET=<hex secret matching /etc/turnserver.conf>
EnvironmentFile=-/etc/earshot.env

[Install]
WantedBy=multi-user.target
